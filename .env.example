# Local development only. Replace the key before deploying.
DJANGO_SECRET_KEY=local-development-key-replace-before-deploying-please-000000000000000000000000
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TRUST_PROXY_SSL_HEADER=false
DATABASE_URL=sqlite:///db.sqlite3
DJANGO_TIME_ZONE=UTC
CURRENCY_LOCALE=en_US
CART_MAX_QUANTITY=10
SUPPLIER_STOCK_MAX_AGE_HOURS=24
SUPPLIER_SYNC_ENABLED=false
SUPPLIER_SYNC_STALE_AFTER_SECONDS=3600
PAYMENT_ENVIRONMENT=sandbox
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
POINTS_PROGRAM_ENABLED=false
GIVEAWAYS_ENABLED=false
REVIEW_RATE_LIMIT_HOURLY=5

# Used only by the local Docker Compose PostgreSQL service.
POSTGRES_DB=morrow
POSTGRES_USER=morrow
POSTGRES_PASSWORD=local-compose-only-password

# Production-only example settings (replace every value; do not enable for local dev):
# DJANGO_DEBUG=false
# DJANGO_ALLOWED_HOSTS=shop.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://shop.example.com
# DJANGO_TRUST_PROXY_SSL_HEADER=true
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
# DATABASE_URL=postgresql://user:password@database-host/morrow
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=...
# EMAIL_HOST_PASSWORD=...
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=Store <orders@shop.example.com>
# PAYMENT_ENVIRONMENT=production
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=
